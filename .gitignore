# build outputs (Maven: */target; ./build.sh --fast: jekyll/build, jekyll/build-<module>)
target/
jekyll/build/
jekyll/build-*/
*.class
# local tracker mirror (regenerated by the watcher)
tracker-app/tracker.json
tracker-app/tracker.json.tmp
progress/
# local CA certs for TLS-inspecting proxies: never commit
docker/extra-ca/*
!docker/extra-ca/.gitkeep
# workspace data (IG clones, golden builds): third-party content, not for this repo
data/
repos/
templates/
work/
.DS_Store
