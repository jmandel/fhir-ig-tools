{"id":"pure-sort","type":"liquid","template":"{{ a | sort | join: ',' }}|{{ h | where: 'k', 'x' | size }}","assigns":{"a":["b","A","c"],"h":[{"k":"x"},{"k":"y"}]}}
{"id":"pure-include","type":"liquid","template":"[{% include 'p' %}]","files":{"p":"P{{ 1 | plus: 1 }}"}}
{"id":"jk-include","type":"jekyll-liquid","template":"[{% include frag.html x='1' %}]{{ site.data.d.v }}","includes":{"frag.html":"F{{ include.x }}"},"data":{"d":{"v":"DATA"}}}
{"id":"jk-markdownify","type":"jekyll-liquid","template":"{{ '*hi*' | markdownify }}","config":{"kramdown":{"toc_levels":"1..3"}}}
{"id":"jk-sort-prop","type":"jekyll-liquid","template":"{{ a | sort: 'n' | map: 'n' | join: ',' }}","assigns":{"a":[{"n":"10"},{"n":"9"},{}]}}
