#!/bin/sh
# Drop-in for `sushi` (the FSH compiler) that runs the Java port: put this file on the PATH as `sushi`, and the IG
# Publisher (or you) runs it like TypeScript SUSHI 3.21.1. Every argument is passed through unchanged; stdout,
# stderr and the exit status are sushi.jar's.
#
# Like the Gradle wrapper, this one file is all you need. A release copy pins a version and the SHA-256 of its
# sushi.jar; on first use it downloads that jar into ~/.fhir-ig-sushi/<version>/, verifies it, and runs it from
# there afterwards (offline). Which jar runs (first match wins):
#   $FHIR_IG_SUSHI_JAR               an explicit jar (offline machines, development)
#   sushi.jar next to this script    (release zip), or target/sushi.jar (source checkout: ./build.sh)
#   the pinned release               cached under ${FHIR_IG_SUSHI_HOME:-$HOME/.fhir-ig-sushi}
# FHIR_IG_SUSHI_URL overrides the download URL (e.g. a mirror). Java: $JAVA_HOME/bin/java if set, else java on
# PATH; it must be 17 or newer. SUSHI_JAVA_OPTS adds JVM options.
set -e
VERSION="@SUSHI_VERSION@"
SHA256="@SUSHI_SHA256@"

die() { echo "sushi (fhir-ig-tools wrapper): $*" >&2; exit 1; }
sha256() {
  if command -v sha256sum >/dev/null 2>&1; then sha256sum "$1"
  elif command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1"
  else openssl dgst -sha256 -r "$1"; fi | cut -c1-64
}
fetch() {  # fetch <url> <file>
  if command -v curl >/dev/null 2>&1; then curl -fsSL --retry 3 -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then wget -q -O "$2" "$1"
  else die "need curl or wget to download $1 (or set FHIR_IG_SUSHI_JAR)"; fi
}

HERE=$(cd "$(dirname "$0")" && pwd)
if [ -n "${FHIR_IG_SUSHI_JAR:-}" ]; then JAR=$FHIR_IG_SUSHI_JAR
elif [ -f "$HERE/sushi.jar" ]; then JAR=$HERE/sushi.jar
elif [ -f "$HERE/target/sushi.jar" ]; then JAR=$HERE/target/sushi.jar
else
  case $VERSION in @*) die "no sushi.jar next to this script and no pinned version; in a source checkout run ./build.sh, or set FHIR_IG_SUSHI_JAR" ;; esac
  DIR=${FHIR_IG_SUSHI_HOME:-$HOME/.fhir-ig-sushi}/$VERSION
  JAR=$DIR/sushi.jar
  if [ ! -f "$JAR" ]; then
    URL=${FHIR_IG_SUSHI_URL:-https://github.com/jmandel/fhir-ig-tools/releases/download/v$VERSION/sushi.jar}
    mkdir -p "$DIR"
    TMP=$DIR/sushi.jar.$$.part
    trap 'rm -f "$TMP"' EXIT
    echo "sushi (fhir-ig-tools wrapper): downloading sushi.jar $VERSION from $URL (first use only)" >&2
    fetch "$URL" "$TMP" || die "download failed: $URL"
    got=$(sha256 "$TMP")
    [ "$got" = "$SHA256" ] || die "checksum mismatch for $URL: expected $SHA256, got $got"
    mv -f "$TMP" "$JAR"   # atomic: concurrent first runs each verify their own copy
    trap - EXIT
  fi
fi
JAVA=java
if [ -n "${JAVA_HOME:-}" ] && [ -x "$JAVA_HOME/bin/java" ]; then JAVA=$JAVA_HOME/bin/java; fi
command -v "$JAVA" >/dev/null 2>&1 || die "Java 17+ not found; install it or set JAVA_HOME"
# Java 17+: `java -version` prints e.g. `openjdk version "21.0.5" ...` (or "1.8.0_402" for Java 8)
jv=$("$JAVA" -version 2>&1 | sed -n 's/.* version "\([^"]*\)".*/\1/p' | head -n 1)
major=${jv%%.*}
[ -n "$major" ] && [ "$major" -ge 17 ] 2>/dev/null || die "sushi.jar needs Java 17 or newer, but $JAVA is version ${jv:-unknown}; set JAVA_HOME to a JDK 17+"
# shellcheck disable=SC2086  # SUSHI_JAVA_OPTS is a list of options
exec "$JAVA" ${SUSHI_JAVA_OPTS:-} -jar "$JAR" "$@"
